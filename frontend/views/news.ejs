<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Tin tức</title>
</head>
<body>
  <a href="/">Trang chủ</a> |
  <a href="/search">Tìm kiếm</a>
  <p><a href="/create">Thêm bài viết mới</a></p>

  <% if (id && newsList.length > 0) { %>
    <h1><%= newsList[0].title %></h1>
    <p><%= newsList[0].description %></p>
    <a href="/edit?id=<%= newsList[0].id %>">Sửa</a> |
    <a href="/delete?id=<%= newsList[0].id %>">Xóa</a>
  <% } else if (newsList.length > 0) { %>
    <h1>Danh sách tin tức</h1>
    <ul>
      <% newsList.forEach((item) => { %>
        <li>
          <a href="/news/<%= item.id %>"><%= item.title %></a>
          | <a href="/edit?id=<%= item.id %>">Sửa</a>
          | <a href="/delete?id=<%= item.id %>">Xóa</a>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <h1>Không tìm thấy bài viết</h1>
  <% } %>
</body>
</html>

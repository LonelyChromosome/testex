<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Đăng nhập</title>
</head>
<body>
  <h1>Đăng nhập</h1>

  <form method="POST" action="/signin">
    <label>Tài khoản</label>
    <input type="text" name="username">

    <label>Mật khẩu</label>
    <input type="password" name="password">

    <button type="submit">Đăng nhập</button>
  </form>

  <a href="/">Trang chủ</a>
</body>
</html>

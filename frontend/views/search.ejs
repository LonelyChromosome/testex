<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Tìm kiếm</title>
</head>
<body>
  <h1>Tìm kiếm sinh viên</h1>

  <form method="GET" action="/search">
    <input
      name="q"
      value="<%= keyword || '' %>"
      placeholder="Nhập tên sinh viên"
    >
    <button type="submit">Tìm</button>
  </form>

  <ul>
    <% results.forEach((student) => { %>
      <li><%= student.name %> - <%= student.email %></li>
    <% }) %>
  </ul>
</body>
</html>
